{
  "name": "scrollring",
  "version": "0.1.0",
  "description": "A tiny framework-agnostic virtual list with DOM node recycling",
  "keywords": [
    "virtual-list",
    "virtual-scroll",
    "windowing",
    "dom-recycling"
  ],
  "homepage": "https://sanil011.github.io/scrollring/",
  "bugs": {
    "url": "https://github.com/sanil011/scrollring/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanil011/scrollring.git"
  },
  "license": "MIT",
  "author": "Sanil (https://github.com/sanil011)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite --open /demo/",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "build:demo": "vite build demo --base=/scrollring/ --outDir=../site --emptyOutDir",
    "docs": "typedoc",
    "build:site": "npm run build:demo && npm run docs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "bench": "node bench/run.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "jsdom": "^29.1.1",
    "tsup": "^9.0.0",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
