{
  "name": "scrollring",
  "version": "0.0.1",
  "description": "A tiny framework-agnostic virtual list with DOM node recycling",
  "keywords": [
    "virtual-list",
    "virtual-scroll",
    "windowing",
    "dom-recycling"
  ],
  "homepage": "https://github.com/sanil011/scrollring#readme",
  "bugs": {
    "url": "https://github.com/sanil011/scrollring/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanil011/scrollring.git"
  },
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "vite --open /demo/",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "bench": "node bench/run.mjs"
  },
  "types": "./dist/index.d.ts",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "jsdom": "^29.1.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
